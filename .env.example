# Copy to .env for local runs. On Render, set these in the dashboard instead.
SARVAM_API_KEY=
DEMO_PASSCODE=
FAKE_SARVAM=0
STT_MODEL=saaras:v4
STT_MODE=transcribe
STT_KEYTERMS=0
LLM_MODEL=sarvam-105b
TTS_MODEL=bulbul:v4-flash
# A Tamil Bulbul v4 Flash persona, e.g. aravind_ta_ads, aravind_ta_suspense, gokul_ta_narration or vijay_ta_narration
TTS_SPEAKER=
LOG_LEVEL=info
